# Copy this file to backend/.env and replace placeholders with your own values.
# Never commit backend/.env or paste real secrets into source files.

PROJECT_NAME="AI Shorts Generator"
API_V1_STR="/api/v1"

# Required for production security. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="replace-with-a-random-secret-key"

# The frontend origin allowed to call the API and receive OAuth popup messages.
# Set to your deployed frontend URL in production (for example https://app.example.com).
FRONTEND_ORIGIN="https://harvest-ai-ebon.vercel.app"

# Database. Leave blank to use the local SQLite database.
# For hosted PostgreSQL, paste your provider's connection URL.
DATABASE_URL=""
# DATABASE_URI is also accepted as an alternative environment variable name.
# DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Object storage. Leave STORAGE_BACKEND=auto for local uploads, or use R2 for Cloudflare.
STORAGE_BACKEND="auto"
R2_ACCOUNT_ID=""
# R2_ENDPOINT_URL can be omitted when R2_ACCOUNT_ID is set.
R2_ENDPOINT_URL=""
R2_REGION="auto"
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
STORAGE_PRESIGNED_URL_TTL=3600

# Optional Backblaze B2 storage settings. Configure these instead of R2 if using B2.
B2_ENDPOINT_URL=""
B2_REGION="us-east-005"
B2_BUCKET=""
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_PRESIGNED_URL_TTL=3600

# Redis/Celery are optional when running one API process: without an active worker,
# the API falls back to background threads. Configure Redis for a separate worker
# service and more reliable processing on deployed applications.
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"
CELERY_CONCURRENCY=2
# Set AUTO_START_CELERY=false when running a separate Celery worker service/container.
AUTO_START_CELERY=true
AUTO_START_OLLAMA=true

# AI/transcription. GROQ_API_KEY enables Groq transcription and highlight analysis.
# Optional Qwen/OpenRouter fallback key.
GROQ_API_KEY=""
QWEN_API_KEY=""

# Optional integrations for music search.
JAMENDO_CLIENT_ID=""
FREESOUND_API_KEY=""
PIXABAY_API_KEY=""

# Optional Google Cloud Speech-to-Text credentials JSON path.
GOOGLE_APPLICATION_CREDENTIALS="backend/gcp-key.json"

# YouTube OAuth (Google Cloud Console > APIs & Services > Credentials).
# Register the exact callback URL below in the OAuth Web application client.
# For production, change localhost to your HTTPS backend domain.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://harvest-ai-soql.onrender.com/api/v1/users/auth/youtube/callback"

# Facebook and Instagram OAuth (Meta for Developers app).
# Register both callback URLs in the Meta app's Valid OAuth Redirect URIs.
# Instagram publishing requires a professional Instagram account linked to a Facebook Page.
# For production, change localhost to your HTTPS backend domain.
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="https://harvest-ai-soql.onrender.com/api/v1/users/auth/facebook/callback"
INSTAGRAM_REDIRECT_URI="https://harvest-ai-soql.onrender.com/api/v1/users/auth/instagram/callback"
# Optional preconfigured social tokens. Usually leave blank: user OAuth connections are saved in the database.
YOUTUBE_ACCESS_TOKEN=""
FACEBOOK_ACCESS_TOKEN=""
FACEBOOK_PAGE_ID=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ID=""
# Instagram API publishing requires Meta to fetch the video from a public HTTPS URL.
PUBLIC_VIDEO_URL=""

# Optional audio catalog settings
AUDIUS_API_BASE="https://api.audius.co"
AUDIUS_APP_NAME="HARVEST_AI"
