PROJECT_NAME="AI Shorts Generator"
API_V1_STR="/api/v1"

# Production Environment and Security
# Generate a secure key in terminal with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=""

# Frontend Origin for CORS and OAuth popups (e.g. https://app.yourdomain.com)
FRONTEND_ORIGIN="http://localhost:5173"

# Database Configuration
# Local SQLite (default for local dev — auto-computed if left blank):
# DATABASE_URL=""
# Neon Serverless PostgreSQL (Recommended 100% Free Production DB):
# DATABASE_URL="postgresql://neondb_owner:your_password@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Redis & Celery Configuration
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Background Service Management
# Set to false in Docker or when running Celery worker as a separate container/service
AUTO_START_CELERY=true
AUTO_START_OLLAMA=true

# Groq Cloud API Key (Free tier for ultra-fast Whisper speech-to-text & Llama 3.3 highlights)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=""

# OpenRouter API Key for Qwen3 (Optional if GROQ_API_KEY is provided)
QWEN_API_KEY=""

# Music & Audio APIs
JAMENDO_CLIENT_ID=""
FREESOUND_API_KEY=""
PIXABAY_API_KEY=""

# Google Cloud Speech-to-Text (place your service account JSON key at the path below)
GOOGLE_APPLICATION_CREDENTIALS="backend/gcp-key.json"

# Meta (Facebook & Instagram) OAuth & Graph API Credentials
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="https://localhost:8000/api/v1/users/auth/facebook/callback"
INSTAGRAM_REDIRECT_URI="https://localhost:8000/api/v1/users/auth/instagram/callback"
INSTAGRAM_BUSINESS_ID=""

# Google / YouTube OAuth & API Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://localhost:8000/api/v1/users/auth/youtube/callback"
