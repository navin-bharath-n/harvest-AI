   },
   "source": [
    "## 📺 Step 7: Preview & Download Output\n",
    "\n",
    "Preview the generated video directly in the notebook, and download the finished MP4 file to your computer."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "preview_download_cell"
   },
   "outputs": [],
   "source": [
    "from google.colab import files\n",
    "from IPython.display import Video, display\n",
    "\n",
    "# Check if clips were generated in Step 6\n",
    "if 'shorts' in locals() and shorts:\n",
    "    selected_short = shorts[0]\n",
    "    \n",
    "    if os.path.exists(selected_short):\n",
    "        print(f\"🎬 Previewing file: {selected_short}\")\n",
    "        # Display the video in notebook\n",
    "        display(Video(selected_short, embed=True, width=360, height=640))\n",
    "        \n",
    "        # Prompt download\n",
    "        download_choice = input(\"📥 Do you want to download this short video? (y/n): \")\n",
    "        if download_choice.lower() == 'y':\n",
    "            files.download(selected_short)\n",
    "            print(\"Starting download...\")\n",
    "    else:\n",
    "        print(f\"❌ Generated file not found at: {selected_short}\")\n",
    "else:\n",
    "    print(\"❌ No shorts variables are loaded. Run Step 6 to generate a video.\")"
   ]
  }
